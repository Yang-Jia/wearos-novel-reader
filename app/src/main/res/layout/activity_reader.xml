<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="2dp"
        app:layout_boxedEdges="all">

        <FrameLayout
            android:id="@+id/readingFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.wear.novelreader.reader.PageView
                android:id="@+id/pageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chapterScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/loading"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/pageInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#66000000"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:textColor="#E6FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menuLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_boxedEdges="all">

        <LinearLayout
            android:id="@+id/menuCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/menuTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/menuClose"
                    style="@style/MenuButton"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/close" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/menuProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/menuChapters"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="@string/chapter_list" />

                        <Button
                            android:id="@+id/menuMode"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/reading_mode" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/menuJump"
                        style="@style/MenuButton"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/chapter_jump_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/menuPrevChapter"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="@string/prev_chapter" />

                        <Button
                            android:id="@+id/menuNextChapter"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/next_chapter" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/menuReverse"
                        style="@style/MenuButton"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/reverse_taps_off" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/menuFontMinus"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="@string/font_smaller" />

                        <Button
                            android:id="@+id/menuFontPlus"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/font_larger" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/menuLineSpacing"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="@string/line_spacing" />

                        <Button
                            android:id="@+id/menuTheme"
                            style="@style/MenuButton"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/theme" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/menuFontColor"
                        style="@style/MenuButton"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/font_color" />

                    <Button
                        android:id="@+id/menuKeepScreenOn"
                        style="@style/MenuButton"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/keep_screen_on_on" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/menuBrightnessLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/brightness_follow_system"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <SeekBar
                                android:id="@+id/menuBrightnessSeek"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:min="10"
                                android:progress="100"
                                android:progressTint="@color/accent"
                                android:splitTrack="false"
                                android:thumbTint="@color/accent" />

                            <Button
                                android:id="@+id/menuBrightnessFollow"
                                style="@style/MenuButton"
                                android:layout_width="52dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="4dp"
                                android:text="@string/brightness_follow" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.wear.widget.BoxInsetLayout>








